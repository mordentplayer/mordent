// Cloudflare Workers static-assets config for the mordent.app landing page.
// Deploy from this directory:  npx wrangler deploy
{
  "name": "mordent",
  "compatibility_date": "2026-10-11",
  // Everything in this folder is the site; there is no build step.
  "assets": {
    "directory": ".",
    // Serve 404.html (with a 404 status) for unknown paths.
    "not_found_handling": "404-page"
  },
  // The apex domain is dedicated to this Worker. The `/feedback*` route on the
  // mordent-intake Worker (../../infra/intake/wrangler.toml) handles the
  // feedback form on the same hostname.
  "routes": [
    { "pattern": "mordent.app", "custom_domain": true }
  ]
}
