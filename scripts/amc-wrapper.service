# amc-wrapper.service — systemd unit for the bundled wrapper-lite backend.
#
# Installed to /etc/systemd/system/amc-wrapper.service by
# scripts/install-wrapper.sh, which also substitutes the configured port into
# the ExecStart line. wrapper-lite must run as root and with PREFIX as its
# working directory: the launcher bind-mounts /dev/urandom into ./rootfs/dev,
# then chdir+chroots into ./rootfs and execs /system/bin/lite.
#
# Manage with: systemctl status|restart amc-wrapper
# Logs:        journalctl -u amc-wrapper -f

[Unit]
Description=amc wrapper-lite (Apple Music FairPlay decryption backend)
Documentation=https://github.com/WorldObservationLog/wrapper/tree/lite
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/amc-wrapper
ExecStart=/opt/amc-wrapper/wrapper-lite --host 127.0.0.1 --port 12340
Restart=on-failure
RestartSec=3
KillMode=control-group
TimeoutStopSec=10
LimitNOFILE=65536
# Required: the launcher needs CAP_SYS_ADMIN to bind-mount /dev/urandom and to
# mount proc inside the chroot. Do not add NoNewPrivileges/ProtectSystem here.
User=root
Group=root

[Install]
WantedBy=multi-user.target
